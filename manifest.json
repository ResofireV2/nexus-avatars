{
  "$schema": "https://billyrayfoss.com/manifest_schema.json",
  "manifest_version": 2,
  "name": "Nexus Avatars",
  "slug": "nexus-avatars",
  "version": "1.3.0",
  "module": "NexusAvatars",
  "description": "Automatically generates unique avatars for every user. Six distinct styles: Mech, Feline, Canine, Inkblot, Emblem, and Snowflake.",
  "author": "ResofireV2",
  "homepage": "https://github.com/ResofireV2/nexus-avatars",
  "repository": "https://github.com/ResofireV2/nexus-avatars",
  "license": "MIT",
  "tags": ["community", "utilities"],
  "logo_url": "/ext/nexus-avatars/assets/logo.webp",
  "banner_url": "/ext/nexus-avatars/assets/banner.webp",
  "js_bundle": "nexus-avatars.js",

  "hooks": [
    { "event": "user_registered", "priority": 50 }
  ],

  "slots": [
    "profile_sidebar"
  ],

  "admin_panel": {
    "label": "Nexus Avatars",
    "icon": "fa-masks-theater"
  },

  "routes": [],
  "right_widgets": [],
  "toolbar_buttons": [],
  "profile_tabs": [],
  "digest_sections": [],
  "capabilities": []
}
